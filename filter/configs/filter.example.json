{
  "output_dir": "../results",
  "datasets": [
    {
      "name": "afm",
      "path": "../data/references/mp/AFM",
      "role": "reference",
      "label": "AFM"
    },
    {
      "name": "fm",
      "path": "../data/references/mp/FM",
      "role": "reference",
      "label": "FM"
    },
    {
      "name": "fim",
      "path": "../data/references/mp/FiM",
      "role": "reference",
      "label": "FiM"
    },
    {
      "name": "nm",
      "path": "../data/references/mp/NM",
      "role": "reference",
      "label": "NM"
    },
    {
      "name": "query",
      "path": "../data/query",
      "role": "query"
    }
  ],
  "extraction": {
    "neighbor_cutoff": 3.2,
    "max_mm_distance": 8.0,
    "contact_norm_cutoff": 1.2,
    "bond_scale": 1.3,
    "min_center_score": 0.05,
    "min_pair_weight": 0.05,
    "max_sites": 500,
    "symprec": 0.1,
    "min_oxidation_coverage": 1.0
  },
  "reference": {
    "feature_set": "main",
    "knn_k": 15,
    "clip_z": 8.0,
    "min_feature_coverage": 0.2,
    "near_constant_tol": 1e-08
  }
}
