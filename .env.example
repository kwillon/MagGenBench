# Optional host paths used by compose.yaml.
# Copy to .env locally or export these variables before running Docker Compose.

# Required: directory containing externally supplied frozen Analysis v1 artifacts.
# For the documented reproduction command, this directory must contain
# baseline_joined.csv at its root.
MAGGENBENCH_ARTIFACT_ROOT=/path/to/frozen-artifacts

# Optional: host-visible directory for reproduced outputs.
# compose.yaml defaults this to ./reproduced when unset.
MAGGENBENCH_OUTPUT_ROOT=./reproduced
